{
  "name": "noname-electron-debian",
  "version": "1.0.0",
  "description": "Debian 13 Electron client for Noname built against the latest stable Electron line.",
  "main": "src/main.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "Codex",
  "homepage": "https://github.com/nonameShijian/noname",
  "repository": {
    "type": "git",
    "url": "https://github.com/nonameShijian/noname.git"
  },
  "scripts": {
    "prepare:icon": "node scripts/make-icon.mjs",
    "test": "node --test",
    "verify": "node scripts/verify.mjs",
    "start": "npm run prepare:icon && electron .",
    "build": "npm run prepare:icon && electron-builder --linux deb AppImage --x64",
    "build:deb": "npm run prepare:icon && electron-builder --linux deb --x64",
    "build:appimage": "npm run prepare:icon && electron-builder --linux AppImage --x64",
    "build:dir": "npm run prepare:icon && electron-builder --linux dir --x64",
    "sync:game": "node scripts/sync-game.mjs"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3"
  },
  "devDependencies": {
    "electron": "42.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.noname.electron.debian",
    "productName": "无名杀",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "LICENSES/**/*",
      "game/README.md"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "executableName": "noname-electron",
      "icon": "assets/icon.png",
      "maintainer": "Codex <codex@example.invalid>",
      "desktop": {
        "entry": {
          "Name": "无名杀",
          "Comment": "Noname Electron client for Debian 13"
        }
      },
      "artifactName": "noname-electron-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageName": "noname-electron",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "artifactName": "noname-electron-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "noname-electron-${version}-${arch}.${ext}"
    }
  }
}
